<!-- indexer::stop -->
<div class="<?php echo $this->class; ?> block"<?php echo $this->cssID; ?><?php if ($this->style): ?> style="<?php echo $this->style; ?>"<?php endif; ?>>
	<?php if ($this->headline): ?>
		<<?php echo $this->hl; ?>><?php echo $this->headline; ?></<?php echo $this->hl; ?>>
	<?php endif; ?>

	<?php
		/*
		 * Der Viewer von Chesstempo ist ein eigenes HTML-Element. Es baut Brett,
		 * Zugliste, Bedienknöpfe, Kopfzeile und die Auswahlliste der Partien
		 * selbst auf. Der Inhalt des Elements ist wegen has-url die Adresse der
		 * PGN-Datei, die der Viewer im Browser nachlädt.
		 */
	?>
	<ct-pgn-viewer
		has-url="true"
		board-pieceStyle="<?php echo $this->pieceSet; ?>"<?php if ($this->boardStyle): ?>
		board-boardStyle="<?php echo $this->boardStyle; ?>"<?php endif; ?>
		board-size="<?php echo $this->boardSize; ?>"
		board-coords-style="<?php echo $this->coordsStyle; ?>"
		board-disable-sound="<?php echo $this->disableSound; ?>"
		use-game-header="<?php echo $this->gameHeader; ?>"
		move-list-position="<?php echo $this->movePosition; ?>"
		move-list-moveListStyle="<?php echo $this->moveListStyle; ?>"
		move-list-autoplaySpeed="<?php echo $this->autoplaySpeed; ?>"
		move-list-resizable="true"<?php if ($this->notationSize): ?>
		style="--pgn-notation-height:<?php echo $this->notationSize; ?>px"<?php endif; ?>><?php echo $this->pgnUrl; ?></ct-pgn-viewer>

	<?php if ($this->pgn_backlink): ?>
		<!-- Der Viewer darf auf nicht-kommerziellen Seiten nur mit diesem Hinweis verwendet werden -->
		<p class="pgn_backlink">PGN Viewer powered by <a href="https://chesstempo.com/" target="_blank" rel="noopener">chesstempo.com</a></p>
	<?php endif; ?>

	<?php if ($this->pgn_download): ?>
		<!-- Download der PGN-Datei -->
		<div class="pgn_download">
			<img src="<?php echo $this->icon; ?>" width="18" height="18" alt="" class="mime_icon">
			<a href="<?php echo $this->href; ?>" title="<?php echo $this->title; ?>"><?php echo $this->link; ?> <span class="size">(<?php echo $this->filesize; ?>)</span></a>
		</div>
	<?php endif; ?>
</div>
<!-- indexer::continue -->
