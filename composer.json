{
    "name": "schachbulle/contao-pgnviewer-bundle",
    "type": "contao-bundle",
    "description": "Inhaltselement, mit dem sich Schachpartien im PGN-Format auf der Website abspielen lassen. Als Engine dient der PGN-Viewer von Chesstempo.",
    "keywords": [
        "contao",
        "schach",
        "pgn",
        "partien",
        "schachbrett"
    ],
    "homepage": "https://github.com/Samson1964/contao-pgnviewer-bundle",
    "license": "LGPL-3.0-or-later",
    "authors": [
        {
            "name": "Frank Hoppe",
            "homepage": "https://www.schachbulle.de/"
        },
        {
            "name": "Wilfried Krebbers",
            "role": "Ursprünglicher Entwickler"
        }
    ],
    "require": {
        "php": "^8.1",
        "contao/core-bundle": "^4.13 || ^5.0",
        "symfony/config": "^5.4 || ^6.4 || ^7.0",
        "symfony/dependency-injection": "^5.4 || ^6.4 || ^7.0",
        "symfony/http-foundation": "^5.4 || ^6.4 || ^7.0",
        "symfony/http-kernel": "^5.4 || ^6.4 || ^7.0"
    },
    "conflict": {
        "contao/core": "*",
        "contao/manager-plugin": "<2.0 || >=3.0"
    },
    "require-dev": {
        "contao/manager-plugin": "^2.0"
    },
    "extra": {
        "contao-manager-plugin": "Schachbulle\\ContaoPgnviewerBundle\\ContaoManager\\Plugin"
    },
    "autoload": {
        "psr-4": {
            "Schachbulle\\ContaoPgnviewerBundle\\": "src/"
        }
    },
    "support": {
        "issues": "https://github.com/Samson1964/contao-pgnviewer-bundle/issues",
        "source": "https://github.com/Samson1964/contao-pgnviewer-bundle"
    }
}
